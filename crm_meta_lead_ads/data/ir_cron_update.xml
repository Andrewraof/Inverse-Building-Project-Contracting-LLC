<odoo>
    <!-- Kept for fresh installs. On existing databases this record is
         noupdate-flagged and never re-applies; the authoritative fix for
         the 5-minute interval is the 19.0.3.1.0 post-migration, which
         writes through the ORM. -->
    <record id="ir_cron_poll_meta_leads" model="ir.cron">
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
