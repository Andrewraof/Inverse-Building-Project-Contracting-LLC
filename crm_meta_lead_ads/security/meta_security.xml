<odoo>
    <record id="res_groups_privilege_meta_leads" model="res.groups.privilege">
        <field name="name">Meta Lead Ads</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_meta_lead_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="crm_meta_lead_ads.res_groups_privilege_meta_leads"/>
    </record>
    <record id="group_meta_lead_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="crm_meta_lead_ads.res_groups_privilege_meta_leads"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_user'))]"/>
    </record>

    <record id="rule_meta_account_company" model="ir.rule"><field name="name">Meta account company</field><field name="model_id" ref="model_meta_account"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_page_company" model="ir.rule"><field name="name">Meta page company</field><field name="model_id" ref="model_meta_page"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_form_company" model="ir.rule"><field name="name">Meta form company</field><field name="model_id" ref="model_meta_form"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_mapping_company" model="ir.rule"><field name="name">Meta mapping company</field><field name="model_id" ref="model_meta_form_mapping"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_queue_company" model="ir.rule"><field name="name">Meta queue company</field><field name="model_id" ref="model_meta_lead_queue"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_log_company" model="ir.rule"><field name="name">Meta log company</field><field name="model_id" ref="model_meta_lead_log"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_identity_company" model="ir.rule"><field name="name">Meta identity company</field><field name="model_id" ref="model_meta_lead_identity"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_conversation_company" model="ir.rule"><field name="name">Meta conversation company</field><field name="model_id" ref="model_meta_conversation"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_message_company" model="ir.rule"><field name="name">Meta message company</field><field name="model_id" ref="model_meta_message"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_sync_run_company" model="ir.rule"><field name="name">Meta sync run company</field><field name="model_id" ref="model_meta_sync_run"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_sync_run_line_company" model="ir.rule"><field name="name">Meta sync run line company</field><field name="model_id" ref="model_meta_sync_run_line"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_routing_rule_company" model="ir.rule"><field name="name">Meta routing rule company</field><field name="model_id" ref="model_meta_routing_rule"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_ad_insight_company" model="ir.rule"><field name="name">Meta ad insight company</field><field name="model_id" ref="model_meta_ad_insight"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
