<odoo>
    <record id="group_meta_lead_user" model="res.groups">
        <field name="name">Meta Lead Ads User</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_meta_lead_manager" model="res.groups">
        <field name="name">Meta Lead Ads Manager</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_user'))]"/>
    </record>

    <record id="rule_meta_account_company" model="ir.rule"><field name="name">Meta account company</field><field name="model_id" ref="model_meta_account"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_page_company" model="ir.rule"><field name="name">Meta page company</field><field name="model_id" ref="model_meta_page"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_form_company" model="ir.rule"><field name="name">Meta form company</field><field name="model_id" ref="model_meta_form"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_mapping_company" model="ir.rule"><field name="name">Meta mapping company</field><field name="model_id" ref="model_meta_form_mapping"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_queue_company" model="ir.rule"><field name="name">Meta queue company</field><field name="model_id" ref="model_meta_lead_queue"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_meta_log_company" model="ir.rule"><field name="name">Meta log company</field><field name="model_id" ref="model_meta_lead_log"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
