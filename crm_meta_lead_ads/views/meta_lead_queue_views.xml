<odoo>
    <record id="view_meta_queue_search" model="ir.ui.view"><field name="name">meta.lead.queue.search</field><field name="model">meta.lead.queue</field><field name="arch" type="xml"><search><field name="meta_lead_id"/><field name="page_id"/><field name="form_id"/><filter name="pending" string="Pending / Retry" domain="[('state','in',['pending','retry'])]"/><filter name="ambiguous" string="Ambiguous" domain="[('state','=','ambiguous')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><group colspan="16"><filter string="State" name="group_state" context="{'group_by':'state'}"/><filter string="Match Result" name="group_match_result" context="{'group_by':'match_result'}"/><filter string="Page" name="group_page" context="{'group_by':'page_id'}"/></group></search></field></record>
    <record id="view_meta_queue_list" model="ir.ui.view"><field name="name">meta.lead.queue.list</field><field name="model">meta.lead.queue</field><field name="arch" type="xml"><list decoration-danger="state == 'failed'" decoration-warning="state == 'ambiguous'" decoration-success="state == 'done'"><header><button name="action_retry_selected" type="object" string="Retry Selected" confirm="Requeue the selected failed/ambiguous records for processing?"/><button name="action_retry_all_failed" type="object" string="Retry All Failed"/></header><field name="received_at"/><field name="meta_lead_id"/><field name="page_id"/><field name="form_id"/><field name="state"/><field name="match_result"/><field name="attempts"/><field name="processing_seconds" optional="hide"/><field name="next_retry_at" optional="hide"/><field name="sync_run_id" optional="hide"/><field name="crm_lead_id"/></list></field></record>
    <record id="view_meta_queue_form" model="ir.ui.view"><field name="name">meta.lead.queue.form</field><field name="model">meta.lead.queue</field><field name="arch" type="xml"><form><header><button name="process_one" type="object" string="Process Now" class="btn-primary" invisible="state not in ['pending','retry','failed','ambiguous']"/><button name="action_retry_selected" type="object" string="Retry" invisible="state not in ['failed','ambiguous','retry']"/><button name="action_reset_pending" type="object" string="Reset to Pending" groups="crm_meta_lead_ads.group_meta_lead_manager" invisible="state in ['pending','processing']"/><button name="action_link_manual_lead" type="object" string="Link Selected Lead" class="btn-primary" invisible="state != 'ambiguous' or not manual_lead_id"/></header><sheet><group><group><field name="company_id"/><field name="page_id"/><field name="form_id"/><field name="meta_lead_id"/><field name="sync_run_id" readonly="1"/></group><group><field name="state"/><field name="match_result"/><field name="attempts"/><field name="processing_seconds" readonly="1"/><field name="next_retry_at"/><field name="crm_lead_id"/><field name="processed_at"/></group></group><group string="Manual Resolution" invisible="state != 'ambiguous'"><field name="manual_lead_id" nolabel="1" domain="[('company_id','in',[company_id, False])]"/></group><group><field name="error_message" readonly="1"/></group><notebook><page string="Webhook"><field name="raw_webhook" readonly="1"/></page><page string="Fetched Lead"><field name="fetched_payload" readonly="1"/></page></notebook></sheet></form></field></record>
    <record id="action_meta_lead_queue" model="ir.actions.act_window"><field name="name">Meta Lead Queue</field><field name="res_model">meta.lead.queue</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_meta_queue_search"/></record>
</odoo>
