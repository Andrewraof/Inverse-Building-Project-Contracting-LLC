<odoo>
    <record id="view_meta_conversation_list" model="ir.ui.view">
        <field name="name">meta.conversation.list</field>
        <field name="model">meta.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="sender_name"/>
                <field name="last_message_preview"/>
                <field name="last_message_at" optional="show"/>
                <field name="unread_count" string="Unread"/>
                <field name="assigned_user_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="page_id" optional="show"/>
                <field name="channel" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_meta_conversation_form" model="ir.ui.view">
        <field name="name">meta.conversation.form</field>
        <field name="model">meta.conversation</field>
        <field name="arch" type="xml">
            <form create="0" edit="1">
                <header>
                    <button name="action_reply_from_form" type="object" string="Send Reply" class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_assign_to_me" type="object" string="Assign to Me"/>
                    <button name="action_mark_read" type="object" string="Mark Read" invisible="unread_count == 0"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'closed'"/>
                    <button name="action_create_lead" type="object" string="Create Lead" invisible="lead_id != False"/>
                    <button name="action_link_lead" type="object" string="Link Existing Lead" invisible="lead_id != False"/>
                    <button name="action_open_lead" type="object" string="Open Lead" invisible="lead_id == False"/>
                    <button name="action_convert_to_opportunity" type="object" string="Convert to Opportunity" invisible="lead_id != False"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,open,pending,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="sender_name" placeholder="Customer name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="page_id" readonly="1"/>
                            <field name="channel" readonly="1"/>
                            <field name="psid" readonly="1"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="unread_count" readonly="1"/>
                            <field name="last_message_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="meta_message_ids" readonly="1">
                                <list create="0" edit="0" delete="0" default_order="sent_at asc, id asc">
                                    <field name="sent_at"/>
                                    <field name="direction" widget="badge"/>
                                    <field name="sender_name"/>
                                    <field name="message_text"/>
                                    <field name="send_state" widget="badge" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details" name="details">
                            <group>
                                <group>
                                    <field name="partner_id"/>
                                    <field name="lead_id" domain="[('company_id','in',[company_id, False])]"/>
                                    <field name="meta_thread_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_inbound_at" readonly="1"/>
                                    <field name="first_response_seconds" readonly="1"/>
                                    <field name="history_synced_at" readonly="1"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                    <field name="active" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group string="Reply" invisible="state == 'closed'">
                        <field name="reply_draft" nolabel="1" placeholder="Write a reply to the customer, then press Send Reply..."/>
                    </group>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="view_meta_conversation_search" model="ir.ui.view">
        <field name="name">meta.conversation.search</field>
        <field name="model">meta.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="sender_name"/>
                <field name="psid"/>
                <field name="last_message_preview" string="Message"/>
                <filter name="filter_unread" string="Unread" domain="[('unread_count', '&gt;', 0)]"/>
                <filter name="filter_state_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_state_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="filter_state_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_state_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="filter_mine" string="Assigned to Me" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="filter_overdue" string="Needs Response &gt; 24h" domain="[('state', '=', 'open'), ('last_inbound_at', '&lt;', (datetime.datetime.now() - datetime.timedelta(hours=24)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="filter_awaiting_response" string="Awaiting First Response" domain="[('last_inbound_at', '!=', False), ('first_response_at', '=', False)]"/>
                <separator/>
                <filter name="filter_last_inbound" string="Last Inbound" date="last_inbound_at"/>
                <separator/>
                <filter name="group_page" string="Page" context="{'group_by': 'page_id'}"/>
                <filter name="group_assigned" string="Assignee" context="{'group_by': 'assigned_user_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
            </search>
        </field>
    </record>

    <record id="action_meta_conversation" model="ir.actions.act_window">
        <field name="name">Meta Inbox</field>
        <field name="res_model">meta.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_conversation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations yet. Incoming Messenger messages will appear here automatically.
            </p>
        </field>
    </record>
</odoo>
