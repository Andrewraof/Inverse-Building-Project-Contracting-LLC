<odoo>
    <!-- Ad performance / CPL: populated only once Meta grants ads_read -->
    <record id="view_meta_ad_insight_list" model="ir.ui.view">
        <field name="name">meta.ad.insight.list</field>
        <field name="model">meta.ad.insight</field>
        <field name="arch" type="xml">
            <list string="Meta Ad Insights">
                <field name="date"/>
                <field name="meta_campaign_name"/>
                <field name="meta_adset_name"/>
                <field name="meta_ad_name"/>
                <field name="spend"/>
                <field name="impressions"/>
                <field name="clicks"/>
                <field name="leads_count"/>
                <field name="cpl"/>
            </list>
        </field>
    </record>
    <record id="view_meta_ad_insight_pivot" model="ir.ui.view">
        <field name="name">meta.ad.insight.pivot</field>
        <field name="model">meta.ad.insight</field>
        <field name="arch" type="xml">
            <pivot string="Meta Ad Insights" disable_linking="True">
                <field name="meta_campaign_name" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="spend" type="measure"/>
                <field name="leads_count" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_meta_ad_insight" model="ir.actions.act_window">
        <field name="name">Ad Performance (CPL)</field>
        <field name="res_model">meta.ad.insight</field>
        <field name="view_mode">pivot,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ad performance data yet.</p>
            <p>Populated automatically once Meta grants the ads_read permission (Advanced Access). Without it this report stays empty — no scraping, no paid service.</p>
        </field>
    </record>
</odoo>
