<odoo>
    <record id="view_meta_message_list" model="ir.ui.view">
        <field name="name">meta.message.list</field><field name="model">meta.message</field>
        <field name="arch" type="xml"><list><field name="sent_at"/><field name="direction" widget="badge"/><field name="sender_name"/><field name="message_text"/><field name="attachments_summary" optional="show"/><field name="send_state" widget="badge" optional="show"/><field name="conversation_id" optional="hide"/><field name="page_id"/><field name="is_first_message" optional="hide"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field>
    </record>
    <record id="view_meta_message_form" model="ir.ui.view">
        <field name="name">meta.message.form</field><field name="model">meta.message</field>
        <field name="arch" type="xml">
            <form string="Meta Message" create="0" edit="0">
                <sheet>
                    <group><group><field name="sender_name"/><field name="sender_psid"/><field name="page_id"/><field name="conversation_id"/></group><group><field name="sent_at"/><field name="direction"/><field name="send_state"/><field name="failure_reason" invisible="not failure_reason"/><field name="is_first_message"/><field name="meta_message_id"/></group></group>
                    <group><field name="message_text" nolabel="1"/></group>
                    <group invisible="not attachments_summary"><field name="attachments_summary" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_meta_message" model="ir.actions.act_window">
        <field name="name">Meta Messages</field><field name="res_model">meta.message</field><field name="view_mode">list,form</field>
    </record>
</odoo>
