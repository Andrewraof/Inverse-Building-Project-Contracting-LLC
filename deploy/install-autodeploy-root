#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this installer as root." >&2
  exit 77
fi

install -o root -g root -m 0755 \
  /home/deploy/deploy-inverse-odoo \
  /usr/local/sbin/deploy-inverse-odoo

cat > /etc/sudoers.d/inverse-odoo-deploy <<'EOF'
deploy ALL=(root) NOPASSWD: /usr/local/sbin/deploy-inverse-odoo *
EOF
chmod 0440 /etc/sudoers.d/inverse-odoo-deploy
visudo -cf /etc/sudoers.d/inverse-odoo-deploy

echo "Installed /usr/local/sbin/deploy-inverse-odoo"
echo "Installed and validated /etc/sudoers.d/inverse-odoo-deploy"
