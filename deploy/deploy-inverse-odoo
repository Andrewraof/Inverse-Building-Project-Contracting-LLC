#!/usr/bin/env bash
set -Eeuo pipefail

readonly REPOSITORY_URL="https://github.com/Andrewraof/Inverse-Building-Project-Contracting-LLC.git"
readonly MODULE_NAMES=("hvac_sales_extension" "crm_meta_lead_ads")
readonly TARGET_ROOT="/opt/odoo/custom-addons/boq-budget"
readonly RELEASE_ROOT="/var/lib/odoo-deploy/inverse-building"
readonly BACKUP_ROOT="/var/backups/odoo-deploy"
readonly ODOO_BIN="/opt/odoo/odoo19/odoo-bin"
readonly ODOO_CONFIG="/etc/odoo19.conf"
readonly ODOO_SERVICE="odoo19.service"
readonly LOCK_FILE="/run/lock/deploy-inverse-odoo.lock"
readonly PRODUCTION_DATABASES=("inverse_elite")

REVISION="${1:-}"
if [[ ! "$REVISION" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Usage: $0 <full-git-commit-sha>" >&2
  exit 64
fi
if [[ "${EUID}" -ne 0 ]]; then
  echo "This deployment command must run as root." >&2
  exit 77
fi

exec 9>"$LOCK_FILE"
flock -n 9 || { echo "Another deployment is already running." >&2; exit 75; }

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
release_dir="${RELEASE_ROOT}/${REVISION}"
backup_dir="${BACKUP_ROOT}/${timestamp}-${REVISION:0:12}"
files_changed=0
service_stopped=0

rollback() {
  local exit_code=$?
  trap - ERR
  echo "Deployment failed (exit ${exit_code}); starting rollback." >&2
  if [[ "$files_changed" -eq 1 ]]; then
    for module_name in "${MODULE_NAMES[@]}"; do
      target_module="${TARGET_ROOT}/${module_name}"
      rm -rf "$target_module"
      if [[ -f "${backup_dir}/${module_name}.tar.gz" ]]; then
        tar -xzf "${backup_dir}/${module_name}.tar.gz" -C "$TARGET_ROOT"
        chown -R odoo:odoo "$target_module"
      fi
    done
  fi
  if [[ "$service_stopped" -eq 1 ]]; then
    systemctl start "$ODOO_SERVICE" || true
  fi
  echo "Database backups, when created, are retained in ${backup_dir}." >&2
  exit "$exit_code"
}
trap rollback ERR

mkdir -p "$RELEASE_ROOT" "$backup_dir"
if [[ ! -d "${release_dir}/.git" ]]; then
  git clone --filter=blob:none --no-checkout "$REPOSITORY_URL" "$release_dir"
fi
git -C "$release_dir" fetch --depth 1 origin "$REVISION"
git -C "$release_dir" checkout --detach --force FETCH_HEAD
git -C "$release_dir" clean -fdx

for module_name in "${MODULE_NAMES[@]}"; do
  python3 "${release_dir}/deploy/validate_addon.py" "${release_dir}/${module_name}"
  target_module="${TARGET_ROOT}/${module_name}"
  if [[ -d "$target_module" ]]; then
    tar -czf "${backup_dir}/${module_name}.tar.gz" -C "$TARGET_ROOT" "$module_name"
  fi
done

installed_updates=()
for database in "${PRODUCTION_DATABASES[@]}"; do
  database_needs_backup=0
  for module_name in "${MODULE_NAMES[@]}"; do
    if runuser -u postgres -- psql -d "$database" -Atqc \
        "SELECT 1 FROM ir_module_module WHERE name='${module_name}' AND state='installed' LIMIT 1" \
        2>/dev/null | grep -qx 1; then
      installed_updates+=("${database}:${module_name}")
      database_needs_backup=1
    fi
  done
  if [[ "$database_needs_backup" -eq 1 ]]; then
    runuser -u postgres -- pg_dump -Fc "$database" > "${backup_dir}/${database}.dump"
  fi
done

for module_name in "${MODULE_NAMES[@]}"; do
  target_module="${TARGET_ROOT}/${module_name}"
  mkdir -p "$target_module"
  rsync -a --delete --exclude='__pycache__/' --exclude='*.pyc' \
    "${release_dir}/${module_name}/" "$target_module/"
  chown -R odoo:odoo "$target_module"
done
files_changed=1

systemctl stop "$ODOO_SERVICE"
service_stopped=1
for update in "${installed_updates[@]}"; do
  database="${update%%:*}"
  module_name="${update#*:}"
  timeout 20m runuser -u odoo -- /usr/bin/python3 "$ODOO_BIN" \
    -c "$ODOO_CONFIG" -d "$database" -u "$module_name" --stop-after-init --no-http
done
systemctl start "$ODOO_SERVICE"
service_stopped=0
systemctl is-active --quiet "$ODOO_SERVICE"

trap - ERR
echo "Deployment complete: ${REVISION}"
echo "Backup directory: ${backup_dir}"
