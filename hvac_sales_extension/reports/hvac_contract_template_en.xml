<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         HVAC Installation Contract — English Template (Pure EN)
         All static labels, legal text, and clauses in English only.
         ═══════════════════════════════════════════════════════════════ -->

    <template id="report_hvac_contract_en">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hvac_sales_extension.hvac_contract_layout">
                    <t t-set="doc" t-value="doc"/>

                    <!-- How many HVAC unit columns are enabled for this order -->
                    <t t-set="n_units" t-value="int(doc.x_show_btu) + int(doc.x_show_cfm) + int(doc.x_show_kw) + int(doc.x_show_hp)"/>
                    <t t-set="total_cols" t-value="4 + n_units"/>

                    <style>
                        .hvac-contract { font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 10pt; line-height: 1.5; color: #1a1a1a; }
                        .contract-title { text-align: center; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; }
                        .contract-title h2 { font-size: 16pt; font-weight: 700; color: #2c3e50; margin: 0 0 4px 0; letter-spacing: 1px; }
                        .contract-title .contract-ref { font-size: 10pt; color: #555; }
                        .info-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
                        .info-table td { padding: 4px 8px; border: 1px solid #bdc3c7; font-size: 9pt; }
                        .info-table td.lbl { background-color: #ecf0f1; font-weight: 600; width: 25%; color: #2c3e50; }
                        .info-table td.val { width: 25%; }
                        .article-title { font-size: 11pt; font-weight: 700; color: #2c3e50; margin: 14px 0 6px 0; padding-bottom: 3px; border-bottom: 1px solid #bdc3c7; }
                        .article-body { text-align: justify; margin-bottom: 10px; }
                        .article-body p { margin: 4px 0; }
                        .article-body ul { margin: 4px 0 4px 20px; padding: 0; }
                        .article-body li { margin-bottom: 3px; }
                        .equip-table { width: 100%; border-collapse: collapse; margin: 8px 0 12px 0; font-size: 8.5pt; }
                        .equip-table thead th { background-color: #2c3e50; color: #fff; padding: 5px 4px; text-align: center; font-weight: 600; border: 1px solid #2c3e50; }
                        .equip-table tbody td { padding: 4px; border: 1px solid #bdc3c7; text-align: center; }
                        .equip-table .section-row td { background-color: #d5dce4; font-weight: 700; text-align: left; font-size: 9pt; color: #2c3e50; }
                        .equip-table .desc-cell { text-align: left; }
                        .equip-table tfoot td { background-color: #ecf0f1; font-weight: 700; border: 1px solid #bdc3c7; padding: 5px 4px; }
                        .page-break { page-break-before: always; padding-top: 10px; }
                        .article-container { page-break-inside: avoid; margin-bottom: 15px; }
                        .governing-law { margin-top: 20px; padding: 8px 12px; background-color: #f8f9fa; border-left: 3px solid #2c3e50; font-style: italic; font-size: 9pt; }
                        .signature-block { margin-top: 40px; page-break-inside: avoid; }
                        .signature-table { width: 100%; border: none; }
                        .signature-table td { width: 50%; text-align: center; padding: 20px; vertical-align: top; }
                        .sig-label { font-weight: 700; font-size: 10pt; color: #2c3e50; border-bottom: 1px solid #2c3e50; padding-bottom: 4px; margin-bottom: 40px; display: inline-block; }
                        .sig-line { margin-top: 50px; border-top: 1px solid #555; width: 60%; margin-left: auto; margin-right: auto; padding-top: 4px; font-size: 8pt; color: #777; }
                    </style>

                    <div class="hvac-contract">

                        <!-- Contract Title -->
                        <div class="contract-title">
                            <h2>HVAC INSTALLATION CONTRACT</h2>
                            <span class="contract-ref">
                                Contract Ref:
                                <t t-out="doc.x_contract_ref or doc.name"/>
                                <t t-if="doc.x_contract_date">
                                    — Date: <t t-out="doc.x_contract_date" t-options='{"widget": "date"}'/>
                                </t>
                            </span>
                        </div>
                        <br/><br/>

                        <!-- Client Information -->
                        <table class="info-table">
                            <tr>
                                <td class="lbl">Client Name</td>
                                <td class="val"><t t-out="doc.partner_id.name"/></td>
                                <td class="lbl">Contract Date</td>
                                <td class="val"><t t-out="doc.x_contract_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Civil ID / PACI No.</td>
                                <td class="val"><t t-out="doc.x_paci_number or '—'"/></td>
                                <td class="lbl">Phone</td>
                                <td class="val"><t t-out="doc.partner_id.phone or '—'"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Machine Brand</td>
                                <td class="val"><t t-out="doc.x_machine_brand_id.name or '—'"/></td>
                                <td class="lbl">Transaction Type</td>
                                <td class="val"><t t-out="doc.x_transaction_type.name or '—'"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Gas Type</td>
                                <td class="val"><t t-out="doc.x_gas_type.name or '—'"/></td>
                                <td class="lbl">Quotation Ref.</td>
                                <td class="val"><t t-out="doc.name"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Site Address</td>
                                <td class="val" colspan="3">
                                    <t t-if="doc.partner_shipping_id">
                                        <t t-out="', '.join(filter(None, [
                                            doc.partner_shipping_id.street or '',
                                            doc.partner_shipping_id.street2 or '',
                                            doc.partner_shipping_id.city or '',
                                            doc.partner_shipping_id.state_id.name if doc.partner_shipping_id.state_id else '',
                                            doc.partner_shipping_id.country_id.name if doc.partner_shipping_id.country_id else '',
                                        ]))"/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </table>

                        <!-- Preamble -->
                        <div class="article-body">
                            <p>
                                <strong><t t-out="doc.company_id.name"/></strong>
                                (hereinafter referred to as the <strong>"Contractor"</strong> or
                                <strong>"First Party"</strong>), leveraging its technical expertise,
                                qualified engineers, and specialized equipment, hereby undertakes to
                                supply, install, and commission central air conditioning systems at
                                the property specified above.
                            </p>
                            <p>
                                Upon mutual agreement and execution of this contract, both parties —
                                the Contractor and <strong><t t-out="doc.partner_id.name"/></strong>
                                (hereinafter referred to as the <strong>"Client"</strong> or
                                <strong>"Second Party"</strong>) — shall be bound by the terms,
                                conditions, and obligations set forth herein.
                            </p>
                        </div>

                        <!-- ARTICLE 1: Equipment Schedule (Static) -->
                        <div class="article-title">Article 1 — Equipment Schedule and Pricing</div>
                        <table class="equip-table">
                            <thead>
                                <tr>
                                    <th style="width:5%">S.No</th>
                                    <th style="width:28%">Description</th>
                                    <th style="width:17%">Model</th>
                                    <th style="width:5%">Qty</th>
                                    <th t-if="doc.x_show_btu" style="width:11%">BTU</th>
                                    <th t-if="doc.x_show_cfm" style="width:10%">CFM</th>
                                    <th t-if="doc.x_show_kw" style="width:9%">kW</th>
                                    <th t-if="doc.x_show_hp" style="width:8%">HP</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="seq" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-if="line.display_type == 'line_section'">
                                        <tr class="section-row">
                                            <td t-att-colspan="total_cols"><t t-out="line.name"/></td>
                                        </tr>
                                        <t t-set="seq" t-value="0"/>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr>
                                            <td t-att-colspan="total_cols" style="text-align:left;font-style:italic;font-size:8pt;">
                                                <t t-out="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="not line.display_type">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <tr>
                                            <td><t t-out="seq"/></td>
                                            <td class="desc-cell"><t t-out="line.name"/></td>
                                            <td><t t-out="line.product_id.default_code or line.product_id.name or '—'"/></td>
                                            <td><t t-out="int(line.product_uom_qty)"/></td>
                                            <td t-if="doc.x_show_btu"><t t-out="'{:,.0f}'.format(line.x_line_btu or 0)"/></td>
                                            <td t-if="doc.x_show_cfm"><t t-out="'{:,.0f}'.format(line.x_line_cfm or 0)"/></td>
                                            <td t-if="doc.x_show_kw"><t t-out="'{:,.2f}'.format(line.x_line_kw or 0)"/></td>
                                            <td t-if="doc.x_show_hp"><t t-out="'{:,.2f}'.format(line.x_line_hp or 0)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr t-if="n_units">
                                    <td colspan="4" style="text-align:right;">PROJECT TOTALS</td>
                                    <td t-if="doc.x_show_btu"><t t-out="'{:,.0f}'.format(doc.x_total_project_btu or 0)"/></td>
                                    <td t-if="doc.x_show_cfm"><t t-out="'{:,.0f}'.format(doc.x_total_project_cfm or 0)"/></td>
                                    <td t-if="doc.x_show_kw"><t t-out="'{:,.2f}'.format(doc.x_total_project_kw or 0)"/></td>
                                    <td t-if="doc.x_show_hp"><t t-out="'{:,.2f}'.format(doc.x_total_project_hp or 0)"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="text-align:right;">TOTAL CONTRACT VALUE</td>
                                    <td t-att-colspan="total_cols - 2" style="text-align:center;">
                                        <t t-out="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ARTICLES 2+ — Dynamic Clauses (EN fields) -->
                        <t t-set="article_num" t-value="1"/>
                        <t t-foreach="clauses" t-as="clause">
                            <t t-if="clause.page_break_before or clause_index == 0">
                                <div class="page-break"/>
                            </t>

                            <div class="article-container">
                                <t t-set="article_num" t-value="article_num + 1"/>

                                <div class="article-title">
                                    Article <t t-out="article_num"/> —
                                    <t t-out="clause.title" t-options='{"widget": "html"}'/>
                                </div>

                                <t t-if="clause.preamble">
                                    <div class="article-body">
                                        <t t-out="clause.preamble" t-options='{"widget": "html"}'/>
                                    </div>
                                </t>

                                <t t-if="clause.child_ids">
                                    <div class="article-body">
                                        <ul>
                                            <t t-foreach="clause.child_ids.sorted(key=lambda c: c.sequence)" t-as="child">
                                                <li>
                                                    <t t-out="child.title" t-options='{"widget": "html"}'/>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Governing Law -->
                        <div class="governing-law">
                            This contract shall be governed by and construed in accordance with the
                            applicable laws and regulations of the <strong>State of Kuwait</strong>.
                            Any disputes arising from or related to this contract shall be subject
                            to the jurisdiction of the competent courts of the State of Kuwait.
                        </div>

                        <!-- Signature Block -->
                        <div class="signature-block">
                            <table class="signature-table">
                                <tr>
                                    <td>
                                        <div class="sig-label">First Party (Contractor)</div>
                                        <br/>
                                        <strong><t t-out="doc.company_id.name"/></strong>
                                        <div class="sig-line">Authorized Signature &amp; Stamp</div>
                                        <img src="/hvac_sales_extension/static/src/img/hvac_stamp.png"
                                             style="display: block; width: 42mm; margin: 10px auto 0 auto; opacity: 0.9;"/>
                                    </td>
                                    <td>
                                        <div class="sig-label">Second Party (Client)</div>
                                        <br/>
                                        <strong><t t-out="doc.partner_id.name"/></strong>
                                        <div class="sig-line">Signature</div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div><!-- /hvac-contract -->
                </t>
            </t>
        </t>
    </template>

</odoo>
