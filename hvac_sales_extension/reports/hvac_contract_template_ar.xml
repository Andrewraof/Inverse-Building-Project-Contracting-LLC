<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         عقد تركيب أنظمة التكييف المركزي — النسخة العربية
         Arabic Template (Pure AR) — RTL layout
         Static labels: professional Arabic translation
         Dynamic clauses: reads title_ar (fallback to title if empty)
         ═══════════════════════════════════════════════════════════════ -->

    <template id="report_hvac_contract_ar">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hvac_sales_extension.hvac_contract_layout">
                    <t t-set="doc" t-value="doc"/>

                    <!-- عدد أعمدة وحدات القياس المفعّلة لهذا الطلب -->
                    <t t-set="n_units" t-value="int(doc.x_show_btu) + int(doc.x_show_cfm) + int(doc.x_show_kw) + int(doc.x_show_hp)"/>
                    <t t-set="total_cols" t-value="4 + n_units"/>

                    <style>
                        .hvac-contract-ar {
                            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
                            font-size: 10pt;
                            line-height: 1.7;
                            color: #1a1a1a;
                            direction: rtl;
                            text-align: right;
                        }
                        .contract-title { text-align: center; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; }
                        .contract-title h2 { font-size: 16pt; font-weight: 700; color: #2c3e50; margin: 0 0 4px 0; letter-spacing: 0px; }
                        .contract-title .contract-ref { font-size: 10pt; color: #555; }
                        .info-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; direction: rtl; }
                        .info-table td { padding: 4px 8px; border: 1px solid #bdc3c7; font-size: 9pt; }
                        .info-table td.lbl { background-color: #ecf0f1; font-weight: 600; width: 25%; color: #2c3e50; text-align: right; }
                        .info-table td.val { width: 25%; text-align: right; }
                        .article-title { font-size: 11pt; font-weight: 700; color: #2c3e50; margin: 14px 0 6px 0; padding-bottom: 3px; border-bottom: 1px solid #bdc3c7; }
                        .article-body { text-align: justify; margin-bottom: 10px; }
                        .article-body p { margin: 4px 0; }
                        .article-body ul { margin: 4px 0 4px 0; padding-right: 20px; padding-left: 0; list-style-position: inside; }
                        .article-body li { margin-bottom: 3px; }
                        .equip-table { width: 100%; border-collapse: collapse; margin: 8px 0 12px 0; font-size: 8.5pt; direction: rtl; }
                        .equip-table thead th { background-color: #2c3e50; color: #fff; padding: 5px 4px; text-align: center; font-weight: 600; border: 1px solid #2c3e50; }
                        .equip-table tbody td { padding: 4px; border: 1px solid #bdc3c7; text-align: center; }
                        .equip-table .section-row td { background-color: #d5dce4; font-weight: 700; text-align: right; font-size: 9pt; color: #2c3e50; }
                        .equip-table .desc-cell { text-align: right; }
                        .equip-table tfoot td { background-color: #ecf0f1; font-weight: 700; border: 1px solid #bdc3c7; padding: 5px 4px; }
                        .page-break { page-break-before: always; padding-top: 10px; }
                        .article-container { page-break-inside: avoid; margin-bottom: 15px; }
                        .governing-law { margin-top: 20px; padding: 8px 12px; background-color: #f8f9fa; border-right: 3px solid #2c3e50; border-left: none; font-style: italic; font-size: 9pt; }
                        .signature-block { margin-top: 40px; page-break-inside: avoid; }
                        .signature-table { width: 100%; border: none; direction: rtl; }
                        .signature-table td { width: 50%; text-align: center; padding: 20px; vertical-align: top; }
                        .sig-label { font-weight: 700; font-size: 10pt; color: #2c3e50; border-bottom: 1px solid #2c3e50; padding-bottom: 4px; margin-bottom: 40px; display: inline-block; }
                        .sig-line { margin-top: 50px; border-top: 1px solid #555; width: 60%; margin-left: auto; margin-right: auto; padding-top: 4px; font-size: 8pt; color: #777; }
                    </style>

                    <div class="hvac-contract-ar">

                        <!-- عنوان العقد -->
                        <div class="contract-title">
                            <h2>عقد تركيب أنظمة التكييف المركزي</h2>
                            <span class="contract-ref">
                                رقم العقد:                                <t t-out="doc.x_contract_ref or doc.name"/>
                                <t t-if="doc.x_contract_date">
                                    — التاريخ:                                    <t t-out="doc.x_contract_date" t-options='{"widget": "date"}'/>
                                </t>
                            </span>
                        </div>
                        <br/>
                        <br/>

                        <!-- بيانات العميل -->
                        <table class="info-table">
                            <tr>
                                <td class="lbl">اسم العميل</td>
                                <td class="val">
                                    <t t-out="doc.partner_id.name"/>
                                </td>
                                <td class="lbl">تاريخ العقد</td>
                                <td class="val">
                                    <t t-out="doc.x_contract_date" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">الرقم المدني / رقم باكي</td>
                                <td class="val">
                                    <t t-out="doc.x_paci_number or '—'"/>
                                </td>
                                <td class="lbl">رقم الهاتف</td>
                                <td class="val">
                                    <t t-out="doc.partner_id.phone or '—'"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">ماركة الجهاز</td>
                                <td class="val">
                                    <t t-out="doc.x_machine_brand_id.name or '—'"/>
                                </td>
                                <td class="lbl">نوع المعاملة</td>
                                <td class="val">
                                    <t t-out="doc.x_transaction_type.name or '—'"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">نوع الغاز</td>
                                <td class="val">
                                    <t t-out="doc.x_gas_type.name or '—'"/>
                                </td>
                                <td class="lbl">رقم العرض</td>
                                <td class="val">
                                    <t t-out="doc.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">عنوان الموقع</td>
                                <td class="val" colspan="3">
                                    <t t-if="doc.partner_shipping_id">
                                        <t t-out="', '.join(filter(None, [
                                            doc.partner_shipping_id.street or '',
                                            doc.partner_shipping_id.street2 or '',
                                            doc.partner_shipping_id.city or '',
                                            doc.partner_shipping_id.state_id.name if doc.partner_shipping_id.state_id else '',
                                            doc.partner_shipping_id.country_id.name if doc.partner_shipping_id.country_id else '',
                                        ]))"/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </table>

                        <!-- مقدمة العقد -->
                        <div class="article-body">
                            <p>
                                تتعهد شركة                                <strong>
                                    <t t-out="doc.company_id.name"/>
                                </strong>
                                (يُشار إليها فيما يلي بـ                                <strong>"المقاول"</strong> أو
                                <strong>"الطرف الأول"</strong>)، بالاستعانة بخبرتها التقنية
                                ومهندسيها المؤهلين وتجهيزاتها المتخصصة، بتوريد وتركيب وتشغيل
                                أنظمة التكييف المركزي في العقار المحدد أعلاه.
                            </p>
                            <p>
                                بموجب الاتفاق المتبادل وتنفيذ هذا العقد، يلتزم كلا الطرفين —
                                المقاول و                                <strong>
                                    <t t-out="doc.partner_id.name"/>
                                </strong>
                                (يُشار إليه فيما يلي بـ                                <strong>"العميل"</strong> أو
                                <strong>"الطرف الثاني"</strong>) — بالشروط والأحكام والالتزامات
                                المنصوص عليها في هذا العقد.
                            </p>
                        </div>

                        <!-- المادة الأولى: جدول المعدات (ثابتة) -->
                        <div class="article-title">المادة الأولى — جدول المعدات والأسعار</div>
                        <table class="equip-table">
                            <thead>
                                <tr>
                                    <th style="width:5%">م</th>
                                    <th style="width:28%">الوصف</th>
                                    <th style="width:17%">الموديل</th>
                                    <th style="width:5%">الكمية</th>
                                    <th t-if="doc.x_show_btu" style="width:11%">BTU</th>
                                    <th t-if="doc.x_show_cfm" style="width:10%">CFM</th>
                                    <th t-if="doc.x_show_kw" style="width:9%">kW</th>
                                    <th t-if="doc.x_show_hp" style="width:8%">HP</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="seq" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-if="line.display_type == 'line_section'">
                                        <tr class="section-row">
                                            <td t-att-colspan="total_cols">
                                                <t t-out="line.name"/>
                                            </td>
                                        </tr>
                                        <t t-set="seq" t-value="0"/>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr>
                                            <td t-att-colspan="total_cols" style="text-align:right;font-style:italic;font-size:8pt;">
                                                <t t-out="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="not line.display_type">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <tr>
                                            <td>
                                                <t t-out="seq"/>
                                            </td>
                                            <td class="desc-cell">
                                                <t t-out="line.name"/>
                                            </td>
                                            <td>
                                                <t t-out="line.product_id.default_code or line.product_id.name or '—'"/>
                                            </td>
                                            <td>
                                                <t t-out="int(line.product_uom_qty)"/>
                                            </td>
                                            <td t-if="doc.x_show_btu">
                                                <t t-out="'{:,.0f}'.format(line.x_line_btu or 0)"/>
                                            </td>
                                            <td t-if="doc.x_show_cfm">
                                                <t t-out="'{:,.0f}'.format(line.x_line_cfm or 0)"/>
                                            </td>
                                            <td t-if="doc.x_show_kw">
                                                <t t-out="'{:,.2f}'.format(line.x_line_kw or 0)"/>
                                            </td>
                                            <td t-if="doc.x_show_hp">
                                                <t t-out="'{:,.2f}'.format(line.x_line_hp or 0)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr t-if="n_units">
                                    <td colspan="4" style="text-align:right;">الإجماليات</td>
                                    <td t-if="doc.x_show_btu">
                                        <t t-out="'{:,.0f}'.format(doc.x_total_project_btu or 0)"/>
                                    </td>
                                    <td t-if="doc.x_show_cfm">
                                        <t t-out="'{:,.0f}'.format(doc.x_total_project_cfm or 0)"/>
                                    </td>
                                    <td t-if="doc.x_show_kw">
                                        <t t-out="'{:,.2f}'.format(doc.x_total_project_kw or 0)"/>
                                    </td>
                                    <td t-if="doc.x_show_hp">
                                        <t t-out="'{:,.2f}'.format(doc.x_total_project_hp or 0)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="text-align:right;">إجمالي قيمة العقد</td>
                                    <td t-att-colspan="total_cols - 2" style="text-align:center;">
                                        <t t-out="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- المواد الديناميكية (من hvac.contract.clause — الحقول العربية) -->
                        <t t-set="article_num" t-value="1"/>
                        <t t-foreach="clauses" t-as="clause">
                            <t t-if="clause.page_break_before or clause_index == 0">
                                <div class="page-break"/>
                            </t>

                            <div class="article-container">
                                <t t-set="article_num" t-value="article_num + 1"/>

                                <div class="article-title">
                                    المادة                                    <t t-out="article_num"/>
 —
                                                                                                                                                <!-- fallback to EN title if Arabic not filled -->
                                    <t t-if="clause.title_ar">
                                        <t t-out="clause.title_ar" t-options='{"widget": "html"}'/>
                                    </t>
                                    <t t-else="">
                                        <t t-out="clause.title" t-options='{"widget": "html"}'/>
                                    </t>
                                </div>

                                <t t-if="clause.preamble_ar or clause.preamble">
                                    <div class="article-body">
                                        <t t-if="clause.preamble_ar">
                                            <t t-out="clause.preamble_ar" t-options='{"widget": "html"}'/>
                                        </t>
                                        <t t-else="">
                                            <t t-out="clause.preamble" t-options='{"widget": "html"}'/>
                                        </t>
                                    </div>
                                </t>

                                <t t-if="clause.child_ids">
                                    <div class="article-body">
                                        <ul>
                                            <t t-foreach="clause.child_ids.sorted(key=lambda c: c.sequence)" t-as="child">
                                                <li>
                                                    <t t-if="child.title_ar">
                                                        <t t-out="child.title_ar" t-options='{"widget": "html"}'/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-out="child.title" t-options='{"widget": "html"}'/>
                                                    </t>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- القانون الحاكم -->
                        <div class="governing-law">
                            يخضع هذا العقد ويُفسَّر وفقاً للقوانين والأنظمة المعمول بها في
                            <strong>دولة الكويت</strong>، وتختص محاكم دولة الكويت المختصة
                            بالفصل في أي نزاعات تنشأ عن هذا العقد أو تتعلق به.
                        </div>

                        <!-- التوقيعات -->
                        <div class="signature-block">
                            <table class="signature-table">
                                <tr>
                                    <!-- In Arabic contracts: Contractor (First Party) is on the RIGHT -->
                                    <td>
                                        <div class="sig-label">الطرف الثاني (العميل)</div>
                                        <br/>
                                        <strong>
                                            <t t-out="doc.partner_id.name"/>
                                        </strong>
                                        <div class="sig-line">التوقيع</div>
                                    </td>
                                    <td style="position: relative;">
                                        <div class="sig-label">الطرف الأول (المقاول)</div>
                                        <br/>
                                        <strong>
                                            <t t-out="doc.company_id.name"/>
                                        </strong>
                                        <div class="sig-line">التوقيع المعتمد والختم</div>
                                        <img src="/hvac_sales_extension/static/src/img/hvac_stamp.png" style="display: block; width: 42mm; margin: 10px auto 0 auto; opacity: 0.9;"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>                    <!-- /hvac-contract-ar -->
                </t>
            </t>
        </t>
    </template>

</odoo>
